{
  "name": "afriground",
  "version": "0.1.0",
  "private": true,
  "description": "AfriGround — Ground Station as a Service (GSaaS) Platform",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @afriground/web dev",
    "dev:api": "cd apps/api && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:worker": "cd apps/api && celery -A workers.celery_app worker --loglevel=info",
    "build": "pnpm --filter @afriground/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:migrate": "cd apps/api && alembic upgrade head",
    "db:revision": "cd apps/api && alembic revision --autogenerate"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
