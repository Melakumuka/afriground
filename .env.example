# ============================================================================
# AfriGround — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.

# ── General ──────────────────────────────────────────────────────────────────
APP_NAME=AfriGround
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=afriground
POSTGRES_USER=afriground
POSTGRES_PASSWORD=afriground_dev_password
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── MinIO (S3-compatible Object Storage) ─────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=afriground
MINIO_SECRET_KEY=afriground_minio_secret
MINIO_BUCKET_RAW=afriground-raw
MINIO_BUCKET_PROCESSED=afriground-processed
MINIO_USE_SSL=false

# ── Supabase Auth ────────────────────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── API Configuration ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Orbital / TLE Sources ───────────────────────────────────────────────────
CELESTRAK_BASE_URL=https://celestrak.org
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# ── Contact Form / SMTP (apps/web) ──────────────────────────────────────────
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@afriground.space
SMTP_PASS=change-me
CONTACT_FROM=mailer@afriground.space
CONTACT_TO=ops@afriground.space

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=afriground-api
LOG_LEVEL=DEBUG
